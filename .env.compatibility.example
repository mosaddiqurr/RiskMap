# Core application
DATABASE_URL="file:./dev.db"
SESSION_SECRET="a-long-development-secret-change-me-123456"
APP_URL="http://localhost:3000"
NODE_ENV="development"
SESSION_COOKIE_NAME="riskmap_session"
SESSION_TTL_HOURS="168"
LOGIN_RATE_LIMIT="10"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOG_LEVEL="info"

# Scanning: mock is offline and is the safe default
SCAN_MODE="mock"
# Leave false outside a dedicated loopback-only acceptance environment.
ALLOW_LOOPBACK_DEMO_VERIFICATION="false"
SCAN_WORKER_POLL_MS="2500"
SCAN_MAX_CONCURRENCY="2"
SCAN_TIMEOUT_MS="5000"
SCAN_RESPONSE_LIMIT_BYTES="65536"
SCAN_ALLOWED_PORTS="21,22,25,53,80,110,143,443,465,587,993,995,3306,5432,6379,8080,8443,9200,27017,3389"
ASSET_ABSENCE_THRESHOLD="2"
SERVICE_ABSENCE_THRESHOLD="2"
FINDING_RESOLUTION_ABSENCE_THRESHOLD="1"
SCAN_ORGANISATION_RATE_LIMIT="6"
SCAN_GLOBAL_RATE_LIMIT="100"
SCAN_RATE_LIMIT_WINDOW_MS="3600000"
SCAN_JOB_TIMEOUT_MS="300000"
SCAN_JOB_MAX_ATTEMPTS="3"
SCAN_JOB_RETRY_BASE_MS="10000"

# Local worker coordination and health
WORKER_HEARTBEAT_INTERVAL_MS="15000"
WORKER_STALE_AFTER_MS="60000"
WORKER_HEARTBEAT_FILE=".runtime/worker-heartbeat.json"
WORKER_LOCK_FILE=".runtime/worker.lock"

# Public Quick Check rate limiting
QUICK_CHECK_RATE_LIMIT="10"
QUICK_CHECK_WINDOW_MS="60000"

# Optional local browser override; leave empty to use Playwright's managed browser.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
