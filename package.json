{
  "name": "riskmap",
  "version": "4.0.0-rc.1",
  "private": true,
  "description": "Evidence-based exposure analysis, potential attack paths and Best Next Fix prioritization.",
  "scripts": {
    "dev": "next dev",
    "worker": "node --env-file-if-exists=.env --import tsx worker/index.ts",
    "build": "prisma generate && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "healthcheck": "node scripts/healthcheck.mjs",
    "runtime:start": "node scripts/analysis-runtime.mjs start",
    "runtime:stop": "node scripts/analysis-runtime.mjs stop",
    "runtime:status": "node scripts/analysis-runtime.mjs status",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:phase2": "node scripts/validate-phase2.cjs",
    "validate": "npm run validate:structure && npm run validate:routes && npm run validate:phase2",
    "validate:performance": "node --import tsx scripts/analysis-performance.ts",
    "release:check": "npm run validate:lock && npm run db:generate && npm run format:check && npm run typecheck && npm run lint && npm run validate && npm run test && npm run build",
    "validate:lock": "node scripts/validate-lock.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.8.4",
    "clsx": "2.1.1",
    "lucide-react": "0.541.0",
    "next": "15.5.27",
    "react": "19.1.7",
    "react-dom": "19.1.7",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "axe-core": "4.12.1",
    "bcryptjs": "3.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.19",
    "effect": "3.22.0",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "shell-quote": "1.10.0"
  },
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  }
}
