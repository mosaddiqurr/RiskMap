# Active analysis: no environment file is required for local development.
# Set the exact public frontend origin on an HTTPS proxy or separate API host.
# Comma-separated HTTPS origins; HTTP is accepted only for loopback testing.
ANALYSIS_ALLOWED_ORIGINS=""
# Build-time setting only; blank uses same-origin /api/analyze.
# An absolute HTTPS origin without a trailing slash or path.
NEXT_PUBLIC_API_BASE_URL=""
# Optional health-check target; default is the local web process.
APP_URL="http://127.0.0.1:3000"
# Optional local browser override for tests.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
PLAYWRIGHT_PORT="3100"
NODE_ENV="development"
# Development/CI flags, not secrets.
NEXT_TELEMETRY_DISABLED="1"
# PORT="3000"
# Compatibility scanning/database variables are in .env.compatibility.example.
